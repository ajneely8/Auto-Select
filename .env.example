# ─────────────────────────────────────────────────────────────────────────────
# Auto Select website — environment variables
# Copy to .env.local for local development. Everything is optional: unset
# integrations run in "log only" mode and the site still works.
# Set these in your hosting provider's dashboard for production.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL used for canonical links, sitemap, Open Graph, and email links.
NEXT_PUBLIC_SITE_URL=https://autoselectgroups.com

# ── Inventory ────────────────────────────────────────────────────────────────
# "local" = data/inventory.json (default). "feed" = fetch INVENTORY_FEED_URL.
INVENTORY_SOURCE=local
# JSON array or { "vehicles": [...] } in the Vehicle shape (see docs/HANDOFF.md).
INVENTORY_FEED_URL=
INVENTORY_FEED_TOKEN=
INVENTORY_REVALIDATE_SECONDS=900

# ── Leads ────────────────────────────────────────────────────────────────────
# "file" writes to LEAD_DATA_DIR (VPS/local). Use "none" on serverless hosts and rely on CRM_WEBHOOK_URL.
LEAD_STORE=file
LEAD_DATA_DIR=.data
# Where internal lead notifications go (defaults to the business email in src/config/business.ts).
LEAD_NOTIFY_EMAIL=

# ── Integrations (provider-neutral signed webhooks) ─────────────────────────
# Each receives a JSON POST signed with X-AutoSelect-Signature: sha256=HMAC(body, WEBHOOK_SIGNING_SECRET).
# Point them at Zapier/Make/n8n, your CRM's inbound webhook, or a small function that calls Resend/Postmark/Twilio.
EMAIL_WEBHOOK_URL=
EMAIL_FROM="Auto Select <info@autoselectgroups.com>"
SMS_WEBHOOK_URL=
CRM_WEBHOOK_URL=
SCHEDULING_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Protects /api/cron/* and /api/inventory/sync (Vercel Cron sends it automatically).
CRON_SECRET=
# REQUIRED in production. Signs unsubscribe links. Use a long random string (e.g. `openssl rand -hex 32`).
UNSUBSCRIBE_SECRET=
# Optional Cloudflare Turnstile spam protection (server secret). Forms also use a honeypot, timing check, and rate limits.
TURNSTILE_SECRET_KEY=

# ── Inventory assistant ──────────────────────────────────────────────────────
# With a key, the chat uses Claude + inventory tools. Without one, a built-in rules engine answers common questions.
ANTHROPIC_API_KEY=
# Default: claude-opus-5. Any current Claude model ID works.
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_ENABLED=true

# ── Analytics (privacy-conscious; never receives names, phones, emails, VINs, or financial data) ─────────
# Optional first-party endpoint that receives { event, props, path, ts } via sendBeacon.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Set to true to show the analytics consent banner and wait for opt-in.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=false

# ── Internal CRM (/crm) ────────────────────────────────────────────────────
# A private, login-gated dashboard over the lead store. Not linked from the public site, excluded
# from robots.txt, and login always fails unless all three of these are set (fails closed).
# Generate the email + hash with: npm run crm:create-user -- you@example.com "a strong password"
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD_HASH=
# REQUIRED in production. Signs CRM session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
CRM_SESSION_SECRET=

# ── 360° demo ────────────────────────────────────────────────────────────────
# The rendered demonstration 360 sequence shows in development only. Keep false in production.
NEXT_PUBLIC_SHOW_DEMO_360=false
